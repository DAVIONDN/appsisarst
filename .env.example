####################################################################
# SISARST - Sistema Web Integrado de Gestion del Personal
# Red de Salud Tayacaja - Sprint 1: Padron de Personal
#
# Copie este archivo como .env y complete DB_PASSWORD con la clave
# de su servidor MySQL. NUNCA suba el archivo .env al repositorio.
####################################################################

APP_NAME=SISARST
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos ------------------------------------------------
# La base ya existe: se crea con docs/04_BASE_DATOS/01_crear_base_datos_MYSQL.sql
# NO se usan migraciones de Laravel sobre las tablas del dominio.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=red_salud_tayacaja
DB_USERNAME=root
DB_PASSWORD=

# --- Sesion / cache / colas ---------------------------------------
# Se usa el driver de archivos para no crear tablas ajenas al modelo
# entidad-relacion aprobado en el documento de diseno.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Correo (Mailtrap, se usa recien en el Sprint 4 / HU-17) ------
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sisarst@redsaludtayacaja.gob.pe"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
